# Ollama Configuration
# Set this to your Ollama server URL if running on a non-default host
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================================
# ENVIRONMENT REQUIREMENTS
# ============================================================================
#
# Python: 3.12.10 (or compatible 3.12.x)
#
# GPU: NVIDIA RTX 3050 6GB minimum for LLM inference stages
#      Models tested: DeepSeek-V2-Chat (16B parameter)
#      Larger GPUs (8GB+) recommended for batch processing
#
# Dependencies: Install via `pip install -r requirements.txt`
#
# Ollama: Required for LLM inference
#         Install from https://ollama.ai
#         Pull model: `ollama pull deepseek-v2:16b`
#         The server runs on localhost:11434 by default
#
# ============================================================================
